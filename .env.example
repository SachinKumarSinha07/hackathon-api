# Application
APP_NAME=Hackathon API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1

# CORS (comma-separated origins, or * for all)
ALLOWED_ORIGINS=http://localhost:3000

# AWS Bedrock
WS_BEARER_TOKEN_BEDROCK=andskfnoidjfcopdkopsdjcopsdjcosdjcmosdmcol
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MAX_TOKENS=2048
# Applied only to models that support it (e.g. Sonnet 4.5). Sonnet 5 skips it automatically.
# BEDROCK_TEMPERATURE=0.2
BEDROCK_TIMEOUT_SECONDS=60
# Disables TLS certificate verification on the Bedrock client - only for local dev
# BEDROCK_VERIFY_SSL=false


# PostgreSQL database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
# Optionally override the full URL (takes precedence over the parts above)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hackathon
